# Servora Server Environment Variables (Template / Placeholder Values Only)
# Copy to .env and configure for your local environment

PORT=5000
NODE_ENV=development

# Database connection strings (Supabase PostgreSQL)
# Runtime transaction connection pooler (port 6543 with pgbouncer=true)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection / session pooler (port 5432, used for migrations and schema introspection)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cryptographic secrets (must be >= 32 characters in production)
JWT_SECRET="servora-super-secret-jwt-key-min-32-chars-long-development"
JWT_EXPIRES_IN="1h"

# Allowed CORS origins (comma-separated or single URL)
CORS_ORIGIN="http://localhost:5173"

# Local file upload directory
UPLOAD_DIR="./uploads"

# Base URL for public QR verification
PUBLIC_VERIFICATION_BASE_URL="http://localhost:5173/verify"
